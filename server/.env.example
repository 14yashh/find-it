# ──────────────────────────────────────────────
#  FindIt Server – Environment Variables
#  Copy this file to .env and fill in values.
#  NEVER commit .env to version control.
# ──────────────────────────────────────────────

PORT=5000

# MongoDB – authenticated URI (matches docker-compose MONGO_USER / MONGO_PASSWORD)
# Use the same username and password you set in the root .env
MONGODB_URI=mongodb://<MONGO_USER>:<MONGO_PASSWORD>@127.0.0.1:27017/findit?authSource=admin

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS – React dev server origin (must match the frontend URL exactly)
CLIENT_URL=http://localhost:5173

# Seed admin credentials (used by scripts/seed.js only)
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChangeMe123!

# Email notifications via Nodemailer (set true to enable)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@college.edu
EMAIL_PASS=replace_with_smtp_password
EMAIL_FROM="FindIt <no-reply@college.edu>"

# If true, the verification document is deleted from disk after admin approves
DELETE_DOC_AFTER_APPROVAL=false
